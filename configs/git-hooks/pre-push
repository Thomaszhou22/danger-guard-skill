#!/bin/bash
# Danger Guard - Git Pre-Push Hook
# 阻止 force push 到远程仓库
#
# 安装方法：
# 1. 复制此文件到 .git/hooks/pre-push
# 2. chmod +x .git/hooks/pre-push

# 颜色定义
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 读取 stdin 获取 push 信息
while read local_ref local_sha remote_ref remote_sha
do
    # 检查是否是 force push
    # 如果 remote_sha 存在且不是 local_sha 的祖先，则是 force push
    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
        # 检查 remote_sha 是否是 local_sha 的祖先
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            echo -e "${RED}╔═══════════════════════════════════════════════════════════╗${NC}"
            echo -e "${RED}║  🛡️  DANGER GUARD - Force Push 拦截                       ║${NC}"
            echo -e "${RED}╚═══════════════════════════════════════════════════════════╝${NC}"
            echo ""
            echo -e "${YELLOW}检测到 force push 操作:${NC}"
            echo "  分支: $local_ref"
            echo "  远程: $remote_ref"
            echo ""
            echo -e "${YELLOW}这可能会:${NC}"
            echo "  • 覆盖远程仓库的提交历史"
            echo "  • 丢失其他团队成员的工作"
            echo "  • 破坏协作流程"
            echo ""
            echo -e "${YELLOW}建议:${NC}"
            echo "  • 使用 'git pull --rebase' 先同步远程更改"
            echo "  • 使用 'git push --force-with-lease' 更安全的替代方案"
            echo "  • 与团队成员沟通后再进行 force push"
            echo ""
            echo -e "${YELLOW}如果确实需要 force push，请:${NC}"
            echo "  1. 临时禁用此 hook: mv .git/hooks/pre-push .git/hooks/pre-push.bak"
            echo "  2. 执行 push"
            echo "  3. 恢复 hook: mv .git/hooks/pre-push.bak .git/hooks/pre-push"
            echo ""
            exit 1
        fi
    fi
done

# 允许 push
exit 0
